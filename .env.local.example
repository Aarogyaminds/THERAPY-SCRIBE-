# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Supabase project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL as above, plus the "anon" public key. These two are safe to expose to the
# browser (that's how Supabase is designed to work) — they're only used client-side to
# upload session audio directly to Storage via short-lived signed URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any password you choose — this gates the whole app since it has no real login system.
APP_PASSWORD=
# Random long string used to sign the login session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Keeps Supabase from pausing for inactivity — see app/api/cron/keep-alive.
# Generate the same way as SESSION_SECRET, and also set it as an env var on
# the Vercel project (Vercel then auto-sends it as a Bearer token on the
# scheduled cron request).
CRON_SECRET=
